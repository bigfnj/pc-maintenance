<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>pc-maintenance: weekly housekeeping sweep. Reports every class it knows about and removes only the ones whose module declares AutoApply.</Description>
    <URI>\PcMaintenance</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- Weekly, not the 90-minute interval preference-guard uses. Nothing this tool watches is
         caused by a policy refresh, and a sweep of thousands of directories has no business
         running every 90 minutes. StartWhenAvailable covers a machine that was off at 03:00. -->
    <CalendarTrigger>
      <StartBoundary>2026-01-04T03:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek><Sunday /></DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <!-- Canonical SYSTEM form. RunLevel HighestAvailable and NO LogonType element: Task Scheduler
         rejects an explicit ServiceAccount LogonType here with "value incorrectly formatted or out
         of range" (documented in preference-guard, same trap). -->
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "{PAYLOAD}\Invoke-PcMaintenance.ps1" -Apply</Arguments>
      <WorkingDirectory>{PAYLOAD}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
